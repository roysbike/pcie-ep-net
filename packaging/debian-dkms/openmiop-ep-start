#!/bin/sh
# Load openmiop and bring up omi0 with the address in /etc/openmiop.addr
# (one CIDR, e.g. 10.20.0.13/24). Run by openmiop.service.
set -e
ADDR=$(cat /etc/openmiop.addr)
modprobe openmiop_ep
i=0
while ! ip link show omi0 >/dev/null 2>&1; do
	i=$((i + 1))
	[ "$i" -le 50 ] || { echo "openmiop: omi0 did not appear" >&2; exit 1; }
	sleep 0.2
done
ip link set omi0 mtu 9000
ip link set omi0 up
ip addr replace "$ADDR" dev omi0
if command -v nmcli >/dev/null 2>&1; then
	nmcli device set omi0 managed no 2>/dev/null || true
fi
