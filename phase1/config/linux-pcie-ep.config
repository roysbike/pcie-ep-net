# Fragment for a Blade 3 Endpoint kernel (Linux 6.12+ / 6.18).
# Merge with the board defconfig; do not use as a standalone defconfig.

CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MSI_IRQ_DOMAIN=y

CONFIG_PCI_ENDPOINT=y
CONFIG_PCI_ENDPOINT_CONFIGFS=y
CONFIG_PCI_ENDPOINT_MSI_DOORBELL=y
CONFIG_CONFIGFS_FS=y

# Rockchip DesignWare dual-mode controller, endpoint half.
# Host half can stay enabled for pcie2x1l0 / pcie2x1l1 (RTL8125).
CONFIG_PCIE_ROCKCHIP_DW_HOST=y
CONFIG_PCIE_ROCKCHIP_DW_EP=y
CONFIG_PCIE_DW=y
CONFIG_PCIE_DW_EP=y
CONFIG_PCIE_DW_HOST=y

CONFIG_PCI_EPF_TEST=m

# Host-side tester lives on the Cluster Box, not here.
# CONFIG_PCI_ENDPOINT_TEST is not required on the Blade.

CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y

# Debug while bringing the link up.
CONFIG_PCIE_DW_DEBUGFS=y
